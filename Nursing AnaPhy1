}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}
body{overflow-x:hidden;background:linear-gradient(180deg,#c7ccd0 0%,#bfc5c9 52%,#c9ced2 100%)}
body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.025;background-image:linear-gradient(#5f686e 1px,transparent 1px),linear-gradient(90deg,#5f686e 1px,transparent 1px);background-size:48px 48px}
body:after{content:"✚";position:fixed;right:3%;bottom:0;font-size:250px;font-weight:900;line-height:1;color:#7b858e;opacity:.025;pointer-events:none}
.app{max-width:1380px;margin:auto;padding:18px}
.top{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:18px;padding:13px 18px;margin-bottom:18px;border:1px solid #ead6d6;background:#e4e7e9;border-radius:14px;box-shadow:0 5px 20px rgba(110,35,35,.06)}
.brand{display:flex;align-items:center;gap:12px;min-width:240px}.cross{width:40px;height:40px;border-radius:10px;background:var(--red);position:relative;box-shadow:0 5px 15px rgba(198,40,40,.18)}
.cross:before,.cross:after{content:"";position:absolute;background:#e4e7e9;border-radius:2px}.cross:before{width:24px;height:6px;left:8px;top:17px}.cross:after{width:6px;height:24px;left:17px;top:8px}
.brand strong{display:block;letter-spacing:1.8px;font-size:16px;color:var(--red2)}.brand small{color:var(--muted);letter-spacing:1px;font-size:9px}
/* The old floating XP/streak/accuracy/answered HUD is intentionally removed. */
.hud{display:none!important}
.clinical-badge{display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:999px;border:1px solid #edcccc;background:#fff6f6;color:var(--red2);font-size:10px;font-weight:800;letter-spacing:1.2px}.pulse-dot{width:8px;height:8px;border-radius:50%;background:var(--red);box-shadow:0 0 0 5px rgba(198,40,40,.10)}
.screen{margin-top:0}.shell{border:1px solid #ead6d6;background:#e4e7e9;border-radius:18px;box-shadow:var(--shadow);overflow:hidden;position:relative}.shell:before{content:"NURSING REVIEW • ANATOMY & PHYSIOLOGY";position:absolute;top:0;left:0;right:0;padding:7px 16px;font-size:8px;letter-spacing:1.8px;color:#806f6f;border-bottom:1px solid #eadede;background:#fffafa;z-index:2}
.hero{min-height:650px;padding:85px 8%;display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:40px;background:linear-gradient(135deg,#fff 0%,#fff8f8 58%,#ffefef 100%);position:relative}
.hero:after{content:"✚   ♡   ✚";position:absolute;right:3%;bottom:20px;color:rgba(198,40,40,.055);font-size:68px;letter-spacing:16px;pointer-events:none}
.eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--red2);font-size:10px;letter-spacing:1.8px;border:1px solid #e8caca;padding:7px 10px;border-radius:999px;background:#fff5f5;font-weight:900}.dot{width:6px;height:6px;border-radius:50%;background:var(--red)}
h1{font-size:clamp(45px,7vw,92px);line-height:.88;letter-spacing:-4px;margin:22px 0 18px;color:#2d2323}h1 span{color:var(--red)}.hero p{max-width:690px;color:var(--muted);line-height:1.8;font-size:15px}
.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:25px 0}.mini{padding:14px;border:1px solid #ead6d6;background:#e4e7e9;border-radius:12px;text-align:center;box-shadow:0 3px 10px rgba(110,35,35,.04)}.mini b{display:block;color:var(--red);font-size:18px}.mini span{font-size:8px;letter-spacing:1.3px;color:var(--muted)}
.controls{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.controls button,.primary,.ghost{padding:11px 15px;border:1px solid #e2c9c9;border-radius:10px;background:#e4e7e9;color:var(--text);cursor:pointer;font:inherit;transition:.15s ease}.controls button:hover,.ghost:hover{background:#fff3f3;border-color:#c97979;transform:translateY(-1px)}.primary{background:var(--red)!important;color:#fff!important;border-color:var(--red)!important;font-weight:800;box-shadow:0 7px 18px rgba(198,40,40,.18)}.primary:hover{background:var(--red2)!important}
.hero-art{min-height:440px;border:1px solid #e8cece;border-radius:22px;position:relative;display:grid;place-items:center;background:linear-gradient(145deg,#fff,#fff1f1);overflow:hidden;box-shadow:inset 0 0 60px rgba(198,40,40,.04)}
.hero-art:before{content:"NURSING\A REVIEW";white-space:pre;position:absolute;inset:0;display:grid;place-items:center;text-align:center;font-weight:950;line-height:1.1;font-size:46px;letter-spacing:3px;color:rgba(198,40,40,.09)}
.hero-art:after{content:"ECG  ─╱╲──╱╲──   •   BP   •   HR   •   SpO₂";position:absolute;left:24px;right:24px;bottom:25px;color:#9b4a4a;font-size:10px;letter-spacing:1px;border-top:1px solid #ead0d0;padding-top:12px}
.orb{width:230px;height:230px;border:14px solid rgba(198,40,40,.09);border-radius:50%;position:relative;background:radial-gradient(circle,#fff 0 36%,#fff3f3 37% 70%,#ffe5e5 71% 100%);box-shadow:inset 0 0 0 9px rgba(198,40,40,.05),0 12px 35px rgba(110,35,35,.07)}.orb:before{content:"✚";position:absolute;inset:0;display:grid;place-items:center;font-size:112px;color:var(--red);font-weight:300}.orb:after{content:"CARE • KNOWLEDGE • SERVICE";position:absolute;left:-20px;right:-20px;bottom:-34px;text-align:center;color:var(--muted);font-size:9px;letter-spacing:2px}
.scan{position:absolute;left:8%;right:8%;height:2px;top:55%;background:linear-gradient(90deg,transparent,var(--red),transparent);opacity:.32}
.setup,.result,.topics-page,.manual{padding:85px 8%;background:#fff}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:30px}.formgrid label{display:flex;flex-direction:column;gap:8px;font-size:10px;letter-spacing:1.2px;color:var(--muted);font-weight:800}.formgrid select{padding:13px;border:1px solid #e1cccc;border-radius:10px;background:#fffafa;color:var(--text);font:inherit}
.quiz{display:grid;grid-template-columns:270px 1fr;min-height:600px}.side{padding:35px 22px;border-right:1px solid #ead8d8;background:#fff8f8}.side h3{font-size:12px;letter-spacing:1.5px;color:var(--red2)}.topiclist{display:flex;flex-direction:column;gap:6px;max-height:360px;overflow:auto}.topic{padding:9px 10px;border:1px solid transparent;border-radius:8px;color:var(--muted);font-size:10px}.topic.active{background:#ffecec;border-color:#edc2c2;color:var(--red2);font-weight:800}.progress{margin-top:25px}.bar{height:8px;background:#f0dddd;border-radius:99px;overflow:hidden;margin-top:8px}.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--red2),var(--red3));border-radius:99px}
.qmain{padding:48px 7%;background:#fff}.qmeta{display:flex;justify-content:space-between;gap:15px;align-items:center}.tag{display:inline-block;padding:7px 10px;border-radius:999px;background:#f0dede;color:var(--red2);border:1px solid #ebcaca;font-size:9px;letter-spacing:1px;font-weight:800}.qnum{color:var(--muted);font-size:9px;letter-spacing:1.3px}.question{font-size:clamp(24px,3.2vw,42px);line-height:1.18;font-weight:800;letter-spacing:-1px;margin:35px 0;color:#332727}.choices{display:grid;gap:10px;max-width:1000px}.choice{display:flex;align-items:flex-start;gap:12px;width:100%;padding:15px;border:1px solid #e5d5d5;border-radius:12px;background:#e4e7e9;color:var(--text);text-align:left;cursor:pointer;font:inherit;box-shadow:0 3px 10px rgba(110,35,35,.035);transition:.15s ease}.choice:hover{border-color:#cf8585;background:#fff7f7;transform:translateY(-1px)}.letter{min-width:28px;height:28px;display:grid;place-items:center;border-radius:8px;background:#f0dede;color:var(--red2);font-weight:800;font-size:12px}.choice.correct{background:#eff9f2;border-color:#75b98d;color:#245e3b}.choice.correct .letter{background:var(--green);color:#fff}.choice.wrong{background:#f0dede;border-color:#d98585;color:#8e3030}.choice.wrong .letter{background:var(--red);color:#fff}
.feedback{max-width:1000px;margin-top:20px}.explain{padding:18px;border:1px solid #ead6d6;border-left:4px solid var(--red);background:#fffafa;border-radius:12px;color:#5f5151;line-height:1.65}.explain.good{border-left-color:var(--green);background:#f1faf4}.explain.bad{border-left-color:var(--red);background:#fff3f3}.nextrow{display:flex;justify-content:flex-end;margin-top:12px}
.result{text-align:center}.score{font-size:clamp(70px,12vw,150px);font-weight:950;letter-spacing:-8px;color:var(--red)}.review{display:grid;grid-template-columns:1fr 1fr;gap:10px;text-align:left;margin-top:25px}.review .explain{font-size:12px}.topicgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.topiccard{padding:18px;border:1px solid #ead6d6;background:#fffafa;border-radius:15px;min-height:95px}.topiccard b{color:var(--red2);display:block;margin-bottom:7px}.manual p{color:#5f5151;line-height:1.8;max-width:850px}
.footer{padding:18px 5%;border-top:1px solid #eadede;color:#806f6f;font-size:9px;letter-spacing:1px;display:flex;justify-content:space-between;gap:10px;background:#fffafa}
.glow,.neon,.particles,.stars,.hud-grid,.cyber-grid,.matrix,.hologram{display:none!important;opacity:0!important;text-shadow:none!important}
/* Prevent any legacy floating HUD/stat elements from blocking the quiz. */
.stat{display:none!important}
@media(max-width:950px){.hero{grid-template-columns:1fr;padding:70px 7%}.hero-art{min-height:320px}.cards{grid-template-columns:1fr 1fr}.quiz{grid-template-columns:1fr}.side{border-right:0;border-bottom:1px solid #ead8d8}.topiclist{display:flex;overflow:auto;max-height:none}.topic{min-width:max-content}.topicgrid,.review{grid-template-columns:1fr}}
@media(max-width:650px){.app{padding:9px}.top{align-items:flex-start;flex-direction:column}.hero h1{font-size:54px}.formgrid{grid-template-columns:1fr}.setup,.result,.topics-page,.manual{padding:55px 6%}.qmain{padding:28px 6%}}
/* Refined, calmer study interface */
:root{--bg:#f3f6f8;--panel:#fff;--panel2:#f5f7fa;--line:#e4e9ef;--red:#c43b45;--red2:#8d2630;--red3:#e36068;--soft:#fff0f1;--green:#24764a;--text:#202c38;--muted:#687787;--shadow:0 18px 50px rgba(32,44,56,.09)}
html,body{background:#f3f6f8;color:var(--text)}body{background:radial-gradient(ellipse at 85% 0%,#fff1f2 0,transparent 36%),linear-gradient(180deg,#f7f9fb,#edf2f5)}body:before,body:after{display:none}.app{max-width:1200px;padding:22px}.top,.shell{background:#fff;border-color:#e6ebf0;box-shadow:var(--shadow)}.top{border-radius:18px;padding:15px 20px}.shell{border-radius:22px}.shell:before{background:#fbfcfd;color:#84909b;border-color:#edf0f3}.hero{background:linear-gradient(135deg,#fff 0%,#fff8f8 72%,#fff0f1 100%)}.setup,.result,.topics-page,.manual,.qmain{background:#fff}.formgrid{align-items:start}.formgrid label{font-size:11px;letter-spacing:.8px;color:#536272}.formgrid select,.formgrid input{padding:14px 15px;border:1px solid #dce3e9;border-radius:12px;background:#fbfcfd;color:var(--text);font:inherit;outline:none;transition:.18s}.formgrid select:focus,.formgrid input:focus{border-color:#cc646d;box-shadow:0 0 0 4px rgba(196,59,69,.1)}.muted{color:var(--muted)}.primary{border-radius:12px!important}.choice{background:#fbfcfd;border-color:#e2e8ed;border-radius:14px;padding:17px}.choice:hover{background:#fff7f7}.side{background:#fbfcfd}.topic.active{background:#fff0f1}.tag{background:#fff0f1}.keyword-help{font-size:12px;line-height:1.5;letter-spacing:0;color:var(--muted);font-weight:500}.eyebrow{letter-spacing:1.3px}.topiccard{background:#fbfcfd;border-color:#e6ebf0}.controls button{border-radius:12px}.feedback .explain{border-radius:14px}
@media(max-width:760px){.app{padding:12px}.top{padding:12px}.hero{padding:70px 7% 40px;grid-template-columns:1fr}.hero-art{min-height:280px}.quiz{grid-template-columns:1fr}.side{border-right:0;border-bottom:1px solid #ead8d8}.formgrid,.review{grid-template-columns:1fr}.topicgrid{grid-template-columns:1fr 1fr}.setup,.result,.topics-page,.manual{padding:72px 7% 40px}}</head>
