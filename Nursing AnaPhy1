<style>:root{
 --bg:#c9ced2;--panel:#e4e7e9;--panel2:#d9dde0;--line:#d9dde1;
 --red:#c62828;--red2:#8f1d1d;--red3:#e53935;--soft:#fff0f0;
 --green:#2e7d4f;--text:#2b2222;--muted:#786b6b;
